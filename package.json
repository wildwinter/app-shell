{
  "name": "@wildwinter/app-shell",
  "version": "0.15.0",
  "description": "The shared shell for the editor family (Patterpad, Storylet Studio): the app-agnostic design-token grammar, the per-entity colour hash, and the vanilla-TS DOM primitive. Two palettes, one grammar - each app supplies its own palette/fonts over these tokens.",
  "type": "module",
  "license": "MIT",
  "author": "Ian Thomas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wildwinter/app-shell.git"
  },
  "keywords": [
    "shell",
    "design-tokens",
    "dom",
    "electron",
    "wildwinter"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens.css": "./dist/tokens.css",
    "./pane-shell.css": "./dist/pane-shell.css",
    "./menu": {
      "types": "./dist/menu.d.ts",
      "import": "./dist/menu.js",
      "require": "./dist/menu.cjs"
    },
    "./tool-window": {
      "types": "./dist/tool-window.d.ts",
      "import": "./dist/tool-window.js",
      "require": "./dist/tool-window.cjs"
    },
    "./settings.css": {
      "import": "./dist/settings.css",
      "require": "./dist/settings.css"
    },
    "./tool-window.css": {
      "import": "./dist/tool-window.css",
      "require": "./dist/tool-window.css"
    },
    "./confirm.css": {
      "import": "./dist/confirm.css",
      "require": "./dist/confirm.css"
    },
    "./job": {
      "types": "./dist/job.d.ts",
      "import": "./dist/job.js",
      "require": "./dist/job.cjs"
    },
    "./job.css": {
      "import": "./dist/job.css",
      "require": "./dist/job.css"
    },
    "./tooltip.css": {
      "import": "./dist/tooltip.css",
      "require": "./dist/tooltip.css"
    },
    "./about.css": {
      "import": "./dist/about.css",
      "require": "./dist/about.css"
    },
    "./anchored.css": {
      "import": "./dist/anchored.css",
      "require": "./dist/anchored.css"
    },
    "./vc.css": {
      "import": "./dist/vc.css",
      "require": "./dist/vc.css"
    },
    "./identity.css": {
      "import": "./dist/identity.css",
      "require": "./dist/identity.css"
    },
    "./vc-status": {
      "types": "./dist/vc-status.d.ts",
      "import": "./dist/vc-status.js",
      "require": "./dist/vc-status.cjs"
    },
    "./app-store": {
      "types": "./dist/app-store.d.ts",
      "import": "./dist/app-store.js",
      "require": "./dist/app-store.cjs"
    },
    "./notes-editor.css": {
      "import": "./dist/notes-editor.css",
      "require": "./dist/notes-editor.css"
    },
    "./comments.css": {
      "import": "./dist/comments.css",
      "require": "./dist/comments.css"
    },
    "./updater": {
      "types": "./dist/updater.d.ts",
      "import": "./dist/updater.js",
      "require": "./dist/updater.cjs"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js",
      "require": "./dist/session.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "@wildwinter/simple-vc-lib": ">=0.2.0",
    "electron": ">=28",
    "electron-updater": ">=6"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    },
    "@wildwinter/simple-vc-lib": {
      "optional": true
    },
    "electron-updater": {
      "optional": true
    }
  },
  "devDependencies": {
    "@wildwinter/simple-vc-lib": "^0.2.1",
    "electron": "42.6.0",
    "electron-updater": "^6.8.9",
    "jsdom": "^25.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
