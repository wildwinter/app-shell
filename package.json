{
  "name": "@wildwinter/app-shell",
  "version": "0.5.0",
  "description": "The shared shell for the editor family (Patterpad, Storylet Studio): the app-agnostic design-token grammar, the per-entity colour hash, and the vanilla-TS DOM primitive. Two palettes, one grammar - each app supplies its own palette/fonts over these tokens.",
  "type": "module",
  "license": "MIT",
  "author": "Ian Thomas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wildwinter/app-shell.git"
  },
  "keywords": [
    "shell",
    "design-tokens",
    "dom",
    "electron",
    "wildwinter"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tokens.css": "./dist/tokens.css",
    "./pane-shell.css": "./dist/pane-shell.css",
    "./menu": {
      "types": "./dist/menu.d.ts",
      "import": "./dist/menu.js",
      "require": "./dist/menu.cjs"
    },
    "./tool-window": {
      "types": "./dist/tool-window.d.ts",
      "import": "./dist/tool-window.js",
      "require": "./dist/tool-window.cjs"
    },
    "./settings.css": {
      "import": "./dist/settings.css",
      "require": "./dist/settings.css"
    },
    "./tool-window.css": {
      "import": "./dist/tool-window.css",
      "require": "./dist/tool-window.css"
    },
    "./confirm.css": {
      "import": "./dist/confirm.css",
      "require": "./dist/confirm.css"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "electron": ">=28"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "devDependencies": {
    "electron": "42.6.0",
    "jsdom": "^25.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^3.2.7"
  }
}
